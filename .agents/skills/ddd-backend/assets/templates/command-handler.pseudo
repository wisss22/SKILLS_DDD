# Command + CommandHandler Template (language-agnostic pseudocode)
#
# Use this template when creating a new Command and its Handler.
# CQRS separates writes (Commands) from reads (Queries).
#
# Commands:
#   - Represent an INTENT to change state
#   - Named imperatively: CreateX, UpdateX, DeleteX
#   - Are simple DTOs (data transfer objects)
#   - Dispatched through CommandBus
#
# CommandHandlers:
#   - Execute the business logic for one Command
#   - Orchestrate domain objects
#   - One Handler per Command
#   - Do NOT return data (void or minimal acknowledgment)

# ============================================
# COMMAND (Data Transfer Object)
# ============================================

class Create[EntityName]Command:
    # --- Properties ---
    # Use primitive types or Value Objects for the command properties.
    # These represent the INPUT from the outside world (HTTP request, CLI, etc.).

    property id: string            # ID generated by the caller (for idempotency)
    property name: string
    property description: string
    property optionaField: string?  # Optional fields

    # --- Constructor ---
    # Simple DTO - no business logic here.
    # All values come from the caller.

    constructor(id, name, description, optionaField = null):
        self.id = id
        self.name = name
        self.description = description
        self.optionaField = optionaField

# ============================================
# COMMAND HANDLER
# ============================================

class Create[EntityName]CommandHandler:
    # --- Dependencies ---
    # Inject ports (interfaces), not adapters (implementations).
    # The DI container provides the actual implementations.

    property repository: [EntityName]Repository   # Port (interface from Domain)
    property eventBus: EventBus                   # Port (interface from Domain)
    # property [OtherService]: [OtherService]Port  # Other ports as needed

    constructor(repository, eventBus):
        self.repository = repository
        self.eventBus = eventBus

    # --- Handler Method ---
    # Method name can be __invoke, handle, or execute depending on convention.
    # Receives the Command, orchestrates the domain.

    method invoke(command: Create[EntityName]Command): void
        # 1. Validate input (syntactic validation)
        #    - Business rule validation goes in domain objects
        #    - Input format validation can go here

        # 2. Create the domain object (using factory method)
        entity = [EntityName].create(
            [EntityName]Id.fromValue(command.id),
            [EntityName]Name.fromValue(command.name),
            command.description,
            ...
        )

        # 3. Persist the aggregate
        self.repository.save(entity)

        # 4. Publish domain events
        #    Events were recorded by the aggregate during creation.
        #    Publishing here guarantees they're published AFTER persistence succeeds.
        self.eventBus.publish(entity.pullEvents())

# ============================================
# USAGE EXAMPLE (in a Controller or CLI Command)
# ============================================

# In a Controller:
class [EntityName]PostController:
    property commandBus: CommandBus

    method handle(request):
        command = Create[EntityName]Command(
            id: request.body.id,
            name: request.body.name,
            description: request.body.description
        )
        self.commandBus.dispatch(command)
        return Response(status: 201)  # No data returned from command

# ============================================
# KEY RULES
# ============================================
# 1. Commands are DTOs - no behavior, only data
# 2. One CommandHandler per Command
# 3. Commands return VOID (or minimal ID)
# 4. Handlers orchestrate, domain objects execute business logic
# 5. Handlers inject PORTS (interfaces), not concrete implementations
# 6. Publish domain events AFTER persistence succeeds
# 7. Generate command ID on the caller side (for idempotency)
# 8. Keep handlers thin: validate, load, call domain method, save, publish events
